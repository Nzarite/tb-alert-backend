<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Address Table -->
    <changeSet id="1740545825496-1" author="bhcp0212">
        <createTable tableName="address">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_address"/>
            </column>
            <column name="block" type="VARCHAR(255)"/>
            <column name="gp" type="VARCHAR(255)"/>
            <column name="village" type="VARCHAR(255)"/>
            <column name="district" type="VARCHAR(255)"/>
            <column name="state" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Contact Screening Table -->
    <changeSet id="1740545825496-2" author="bhcp0212">
        <createTable tableName="contact_screening">
            <column name="id" type="INT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_contact_screening"/>
            </column>
            <column name="contact_screening_status" type="bit">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_contact_screening" type="DATE"/>
            <column name="hhcs_available" type="INT"/>
            <column name="hhcs_screened" type="INT"/>
            <column name="hhcs_with_tb_symptoms" type="INT"/>
            <column name="hhcs_referred_tb_testing" type="INT"/>
            <column name="hhcs_diagnosed_tb" type="INT"/>
            <column name="hhcs_tb_initiated_att" type="INT"/>
            <column name="hhcs_ltbi_test" type="INT"/>
            <column name="eligible_for_tpt" type="INT"/>
            <column name="hhcs_initiated_tpt" type="INT"/>
            <column name="patient_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Medication Table -->
    <changeSet id="1740545825496-3" author="bhcp0212">
        <createTable tableName="medication">
            <column name="id" type="INT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_medication"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="before_meal" type="bit">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Missed Medication Table -->
    <changeSet id="1740545825496-4" author="bhcp0212">
        <createTable tableName="missed_medication">
            <column name="id" type="INT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_missedmedication"/>
            </column>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="patient_medication_id" type="INT"/>
            <column name="missed_dosages" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- Nikshay Mitra Table -->
    <changeSet id="1740545825496-5" author="bhcp0212">
        <createTable tableName="nikshay_mitra">
            <column name="id" type="INT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_nikshay_mitra"/>
            </column>
            <column name="nikshay_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="udst_status" type="bit">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_udst" type="DATE"/>
            <column name="result_of_udst" type="VARCHAR(255)"/>
            <column name="dbt_status" type="bit">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_dbt" type="DATE"/>
            <column name="nikshay_mitra_status" type="bit">
                <constraints nullable="false"/>
            </column>
            <column name="nikshay_mitra_date" type="DATE"/>
            <column name="nikshay_mitra_name" type="VARCHAR(255)"/>
            <column name="patient_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Patient Table -->
    <changeSet id="1740545825496-6" author="bhcp0212">
        <createTable tableName="patient">
            <column name="id" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_patient"/>
            </column>
            <column name="person_id" type="BIGINT"/>
            <column name="current_status" type="VARCHAR(255)"/>
            <column name="cured" type="bit">
                <constraints nullable="false"/>
            </column>
            <column name="age" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="consent_for_message" type="bit"/>
        </createTable>
    </changeSet>

    <!-- Patient Follow Up Table -->
    <changeSet id="1740545825496-7" author="bhcp0212">
        <createTable tableName="patient_follow_up">
            <column name="id" type="INT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_patientfollowup"/>
            </column>
            <column name="patient_id" type="VARCHAR(36)"/>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)"/>
            <column name="remarks" type="VARCHAR(255)"/>
            <column name="patient_condition" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Patient Medication Table -->
    <changeSet id="1740545825496-8" author="bhcp0212">
        <createTable tableName="patient_medication">
            <column name="id" type="INT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_patientmedication"/>
            </column>
            <column name="patient_id" type="VARCHAR(36)"/>
            <column name="medication_id" type="INT"/>
            <column name="frequency" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Person Table -->
    <changeSet id="1740545825496-37" author="bhcp0212">
        <createTable tableName="person">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="address_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Add foreign key constraint for address_id -->
        <addForeignKeyConstraint baseColumnNames="address_id"
                                 baseTableName="person"
                                 constraintName="fk_person_address"
                                 referencedColumnNames="id"
                                 referencedTableName="address"/>
    </changeSet>

    <!-- Settings Table -->
    <changeSet id="1740545825496-10" author="bhcp0212">
        <createTable tableName="settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_settings"/>
            </column>
            <column name="key_name" type="VARCHAR(255)"/>
            <column name="value" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- State Head Table -->
    <changeSet id="1740545825496-11" author="bhcp0212">
        <createTable tableName="state_head">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_statehead"/>
            </column>
            <column name="person_id" type="BIGINT"/>
            <column name="date_of_joining" type="DATE"/>
            <column name="date_of_leaving" type="DATE"/>
        </createTable>
    </changeSet>

    <!-- TB Details Table -->
    <changeSet id="1740545825496-12" author="bhcp0212">
        <createTable tableName="tb_details">
            <column name="id" type="INT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tb_details"/>
            </column>
            <column name="date_of_diagnosis" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_treatment_initiation" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="type_of_pwtb" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type_of_tb" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="dstb_drtb" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="patient_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Tele Caller Table -->
    <changeSet id="1740545825496-13" author="bhcp0212">
        <createTable tableName="tele_caller">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_telecaller"/>
            </column>
            <column name="person_id" type="BIGINT"/>
            <column name="date_of_joining" type="DATE"/>
            <column name="date_of_leaving" type="DATE"/>
        </createTable>
    </changeSet>

    <!-- Unique Constraints -->
    <changeSet id="1740545825496-14" author="bhcp0212">
        <addUniqueConstraint columnNames="patient_id" constraintName="uc_contact_screening_patient"
                             tableName="contact_screening"/>
    </changeSet>
    <changeSet id="1740545825496-15" author="bhcp0212">
        <addUniqueConstraint columnNames="name" constraintName="uc_medication_name" tableName="medication"/>
    </changeSet>
    <changeSet id="1740545825496-16" author="bhcp0212">
        <addUniqueConstraint columnNames="patient_id" constraintName="uc_nikshay_mitra_patient"
                             tableName="nikshay_mitra"/>
    </changeSet>
    <changeSet id="1740545825496-17" author="bhcp0212">
        <addUniqueConstraint columnNames="email" constraintName="uc_person_email" tableName="person"/>
    </changeSet>
    <changeSet id="1740545825496-18" author="bhcp0212">
        <addUniqueConstraint columnNames="person_id" constraintName="uc_statehead_person" tableName="state_head"/>
    </changeSet>
    <changeSet id="1740545825496-19" author="bhcp0212">
        <addUniqueConstraint columnNames="patient_id" constraintName="uc_tb_details_patient" tableName="tb_details"/>
    </changeSet>
    <changeSet id="1740545825496-20" author="bhcp0212">
        <addUniqueConstraint columnNames="person_id" constraintName="uc_telecaller_person" tableName="tele_caller"/>
    </changeSet>

    <!-- Foreign Key Constraints -->
    <changeSet id="1740545825496-21" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="patient_id" baseTableName="contact_screening"
                                 constraintName="FK_CONTACT_SCREENING_ON_PATIENT" referencedColumnNames="id"
                                 referencedTableName="patient"/>
    </changeSet>
    <changeSet id="1740545825496-22" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="patient_medication_id" baseTableName="missed_medication"
                                 constraintName="FK_MISSEDMEDICATION_ON_PATIENT_MEDICATION" referencedColumnNames="id"
                                 referencedTableName="patient_medication"/>
    </changeSet>
    <changeSet id="1740545825496-23" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="patient_id" baseTableName="nikshay_mitra"
                                 constraintName="FK_NIKSHAY_MITRA_ON_PATIENT" referencedColumnNames="id"
                                 referencedTableName="patient"/>
    </changeSet>
    <changeSet id="1740545825496-24" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="patient_id" baseTableName="patient_follow_up"
                                 constraintName="FK_PATIENTFOLLOWUP_ON_PATIENT" referencedColumnNames="id"
                                 referencedTableName="patient"/>
    </changeSet>
    <changeSet id="1740545825496-25" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="medication_id" baseTableName="patient_medication"
                                 constraintName="FK_PATIENTMEDICATION_ON_MEDICATION" referencedColumnNames="id"
                                 referencedTableName="medication"/>
    </changeSet>
    <changeSet id="1740545825496-26" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="patient_id" baseTableName="patient_medication"
                                 constraintName="FK_PATIENTMEDICATION_ON_PATIENT" referencedColumnNames="id"
                                 referencedTableName="patient"/>
    </changeSet>
    <changeSet id="1740545825496-27" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="person_id" baseTableName="patient"
                                 constraintName="FK_PATIENT_ON_PERSON" referencedColumnNames="id"
                                 referencedTableName="person"/>
    </changeSet>
    <changeSet id="1740545825496-28" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="address_id" baseTableName="person"
                                 constraintName="FK_PERSON_ON_ADDRESS" referencedColumnNames="id"
                                 referencedTableName="address"/>
    </changeSet>
    <changeSet id="1740545825496-29" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="person_id" baseTableName="state_head"
                                 constraintName="FK_STATEHEAD_ON_PERSON" referencedColumnNames="id"
                                 referencedTableName="person"/>
    </changeSet>
    <changeSet id="1740545825496-30" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="patient_id" baseTableName="tb_details"
                                 constraintName="FK_TB_DETAILS_ON_PATIENT" referencedColumnNames="id"
                                 referencedTableName="patient"/>
    </changeSet>
    <changeSet id="1740545825496-31" author="bhcp0212">
        <addForeignKeyConstraint baseColumnNames="person_id" baseTableName="tele_caller"
                                 constraintName="FK_TELECALLER_ON_PERSON" referencedColumnNames="id"
                                 referencedTableName="person"/>
    </changeSet>
    <changeSet id="1740545825496-32" author="bhcp0212">
        <insert tableName="medication">
            <column name="id" value="1"/>
            <column name="name" value="TB Medicine"/>
            <column name="before_meal" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="1740545825496-33" author="bhcp0212">
        <createTable tableName="state">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="state_name" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="state_code" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1740545825496-34" author="bhcp0212">
        <!-- Drop the old state column if it exists -->
        <dropColumn tableName="address" columnName="state"/>

        <!-- Add the new state_id column -->
        <addColumn tableName="address">
            <column name="state_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Add a foreign key constraint -->
        <addForeignKeyConstraint baseColumnNames="state_id"
                                 baseTableName="address"
                                 constraintName="fk_address_state"
                                 referencedColumnNames="id"
                                 referencedTableName="state"/>
    </changeSet>

    <changeSet id="1740545825496-36" author="bhcp0212">
        <insert tableName="state">
            <column name="id" value="1"/>
            <column name="state_name" value="BIHAR"/>
            <column name="state_code" value="BR"/>
        </insert>
        <insert tableName="state">
            <column name="id" value="2"/>
            <column name="state_name" value="TELANGANA"/>
            <column name="state_code" value="TG"/>
        </insert>
        <insert tableName="state">
            <column name="id" value="3"/>
            <column name="state_name" value="UTTAR PRADESH"/>
            <column name="state_code" value="UP"/>
        </insert>
    </changeSet>
</databaseChangeLog>
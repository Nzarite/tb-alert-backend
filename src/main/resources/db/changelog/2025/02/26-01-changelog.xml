    <!-- Create State Table -->
    <changeSet id="1740545825495-1" author="bhcp0212">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="state"/>
            </not>
        </preConditions>
        <createTable tableName="state">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="state_name" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="state_code" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Create District Table -->
    <changeSet id="1740545825495-2" author="bhcp0212">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="district"/>
            </not>
        </preConditions>
        <createTable tableName="district">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="district_name" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="state_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="district"
                                 baseColumnNames="state_id"
                                 referencedTableName="state"
                                 referencedColumnNames="id"
                                 constraintName="fk_district_state"/>
    </changeSet>

